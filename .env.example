# Local Worker development values. Use .dev.vars for Wrangler local secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
OWNER_EMAIL=YOUR_OWNER_EMAIL
ALLOWED_ORIGINS=http://localhost:8787
APP_ENV=development

# Optional server-side AI provider pool. Configure as a Cloudflare Worker secret,
# not in browser code or a committed file.
# AI_PROVIDER_POOL=[{"provider":"...","keyId":"...","baseUrl":"...","model":"...","apiKey":"...","freeOnly":true,"enabled":true,"priority":1}]

# Optional provider-specific server secrets; only enable after verifying free-tier
# eligibility, current terms, permissions and regional availability.
# NVIDIA_NIM_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=
# MAXUN_BASE_URL=
# MAXUN_API_KEY=
